.venv/
__pycache__/
*.pyc
*.parquet

# Shim cache dir (default CACHE_DIR=./xorb-cache), wherever it's created
xorb-cache/

# Rust build artifacts (xet_verify) — 500 MB+, reproducible from Cargo.toml.
# Cargo.lock is intentionally committed (pins transitive deps → reproducible builds).
xet_verify/target/

# Go build output
shim-go/xetcache
xetcache-linux-amd64

# Runpod testbed: run state, secrets, local Flash packaging cache
runpod_testbed/data/
runpod_testbed/config.toml
runpod_testbed/.env
runpod_testbed/worker/.flash/

# Flash CLI local state (created wherever `flash deploy` is invoked from)
.flash/
