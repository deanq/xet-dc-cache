# xet-dc-cache configuration — install to /etc/xet-dc-cache/xet-dc-cache.env
#
# systemd EnvironmentFile format: KEY=value, one per line. No `export`, no
# shell expansion ($VAR is literal), no inline comments after a value.
# Every var has a built-in default (shown); uncomment only what you change.

# REQUIRED for remote workers. Baked verbatim into the URLs handed to clients,
# so it MUST be an address the worker can reach — not localhost. Include the
# port. e.g. http://10.0.0.5:8000  or  http://cache.rack1.dc:8000
PUBLIC_BASE=http://CHANGE-ME:8000

# Listen port (0.0.0.0:PORT). Keep in sync with the :port in PUBLIC_BASE.
PORT=8000

# Where cached xorb ranges + manifests live. Must sit under a path the unit can
# write (StateDirectory/CacheDirectory). /var/cache is the natural home.
CACHE_DIR=/var/cache/xet-dc-cache

# Tier 1 LRU byte cap in GiB. 0 = no byte budget. Size this to the NVMe you gave
# the host; Step 2's locality study picks the real number. The disk-free
# watermark below is a separate, always-on backstop — you can run with just one.
XORB_CACHE_MAX_GIB=100

# Disk-free watermark: keep at least this % of the cache volume free, evicting
# LRU entries when it drops below. Measured against real free space (statfs), so
# it protects the disk regardless of the byte cap or anything else sharing the
# volume. Default 10; valid range 1-99 (>=100 is clamped to 99 with a warning);
# set 0 to disable and rely solely on XORB_CACHE_MAX_GIB.
CACHE_MIN_FREE_PCT=10

# Max concurrent upstream miss fetches. Bounds worst-case RSS (roughly
# cap * largest-range, ranges are <=64 MB) and shields upstreams from a herd of
# cold ranges. 0 = unlimited. Default 32.
MAX_INFLIGHT_FETCHES=32

# Optional shared-secret gate (defense in depth, NOT the trust boundary — see
# deploy/README.md). If set, clients must send `Authorization: Bearer <token>`;
# /healthz and /metrics stay open for probes/scrapers. Unset = open (LAN default).
# SHIM_AUTH_TOKEN=

# --- Rarely changed ---
# HF_UPSTREAM=https://huggingface.co
# CAS_UPSTREAM=https://cas-server.xethub.hf.co
# SIGNED_URL_TTL_SECONDS=3600
# SIGNED_URL_MAX_ENTRIES=100000
# MANIFEST_CACHE_MAX_ENTRIES=50000

# Cross-DC peering (Tier 1.5): comma-separated sibling cache base URLs.
# Empty = disabled. Must be reachable over the private backbone.
# PEERS=https://dc1-host:8000,https://dc2-host:8000
# SELF_URL=https://this-host:8000
# PEER_PROBE_TIMEOUT_MS=200
# PEER_STICKY_TTL_SECONDS=60
# Bounds the peer range GET (request + body read), separate from the HEAD
# probe budget above — must be generous enough for a full multi-MB range.
# PEER_FETCH_TIMEOUT_MS=10000
#
# --- Peer transport tuning (Mechanism A: never start cold) ---
# Idle keep-alive connections kept warm per peer (Go default is 2). A model
# pull is thousands of ranges; a fat pool stops connection thrash. Default 64.
# PEER_MAX_IDLE_CONNS_PER_HOST=64
# SO_RCVBUF/SO_SNDBUF for peer dials, in bytes. 0 = OS autotune (recommended;
# a wrong static value CAPS throughput). Set only where autotuning is disabled.
# PEER_SOCKET_BUFFER_BYTES=0
# Background keepalive ping interval (ms) to keep pooled peer conns open.
# 0 = disabled. Avoids handshake/TLS on the next fetch; does NOT keep the TCP
# congestion window warm — for that set net.ipv4.tcp_slow_start_after_idle=0.
# PEER_KEEPALIVE_INTERVAL_MS=0
